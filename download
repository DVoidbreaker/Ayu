# SECURITY: without this file, `COPY . .` in the Dockerfile bakes every
# secret below permanently into the image's layers - including any that
# existed at build time and were later "removed", since old layers are
# never deleted. Mount these as external volumes / secrets instead.

accounts.json
passwords.json
accounts/
*.session
*.session-journal
*.db
*.db-wal
*.db-shm
*.log
logs/
media/

# Local/dev/VCS clutter that has no business in the image either.
.git/
.gitignore
__pycache__/
*.pyc
.venv/
venv/
*.zip
